# Copy to .env (docker compose) or enter these as stack environment variables in Portainer.

# --- Device ---------------------------------------------------------------
# Network ADB address of the phone / emulator / redroid. Empty = the only USB device.
ADB_SERIAL=192.168.1.50:5555
# global | jp | full package name
GAME_PACKAGE=global
# adb (real device) | sim (built-in demo game, no phone needed)
DEVICE_BACKEND=adb
# Turn the device's "stay awake while charging" on while farming (and off afterwards)
KEEP_SCREEN_ON=true

# --- Farming --------------------------------------------------------------
# Routine started by AUTOSTART when none was picked in the UI yet
ROUTINE=dokkan_auto_farm
# resume = continue after a container/host restart if it was farming; true; false
AUTOSTART=resume
# Daily windows in which to farm, e.g. 23:00-07:00, 13:00-14:00 (empty = always)
ACTIVE_HOURS=
TZ=Europe/Berlin

# --- Web UI ---------------------------------------------------------------
HOST_PORT=8080
WEB_USERNAME=admin
WEB_PASSWORD=change-me

# --- Notifications (https://github.com/caronc/apprise/wiki) ----------------
# Space or comma separated, e.g. tgram://123456:ABC/987654 discord://webhook_id/token ntfy://my-topic
NOTIFY_URLS=
# Also send a progress message every N runs (0 = off)
NOTIFY_EVERY_RUNS=0

# --- Advanced -------------------------------------------------------------
# Image tag (latest, a version like 0.1.0, or sha-xxxxxxx)
IMAGE_TAG=latest
# Downscale factor for template matching (0.2 - 1.0, lower = faster)
MATCH_SCALE=0.5
# Random tap offset as a fraction of the button size (0 - 0.45)
TAP_JITTER=0.15
# Debug screenshots kept in /data/screenshots
SCREENSHOT_KEEP=30
LOG_LEVEL=INFO
# File ownership inside the volume
PUID=1000
PGID=1000
# Needed for USB passthrough (/dev/bus/usb)
RUN_AS_ROOT=false
